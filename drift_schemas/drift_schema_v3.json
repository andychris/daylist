  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"color_hex\" TEXT NOT NULL DEFAULT '#5B4EE8', \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"parent_project_id\" INTEGER NULL REFERENCES projects (id), \"sort_order\" REAL NOT NULL, \"view_type\" TEXT NOT NULL DEFAULT 'list');"
        }
      ]
    },
    {
      "name": "sections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sections\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"project_id\" INTEGER NOT NULL REFERENCES projects (id), \"sort_order\" REAL NOT NULL);"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"archived_at\" INTEGER NULL, \"sort_order\" REAL NOT NULL, \"category\" TEXT NOT NULL DEFAULT 'other', \"reminder_minute_of_day\" INTEGER NULL, \"due_date\" INTEGER NULL, \"recurrence_rule\" TEXT NULL, \"priority\" TEXT NOT NULL DEFAULT 'p4', \"project_id\" INTEGER NULL REFERENCES projects (id), \"section_id\" INTEGER NULL REFERENCES sections (id));"
        }
      ]
    },
    {
      "name": "task_completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_completions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NOT NULL REFERENCES tasks (id), \"date\" TEXT NOT NULL, \"completed_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"task_id\", \"date\"));"
        }
      ]
    },
    {
      "name": "labels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"labels\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"color_hex\" TEXT NOT NULL DEFAULT '#808080');"
        }
      ]
    },
    {
      "name": "task_labels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_labels\" (\"task_id\" INTEGER NOT NULL REFERENCES tasks (id), \"label_id\" INTEGER NOT NULL REFERENCES labels (id), PRIMARY KEY (\"task_id\", \"label_id\"));"
        }
      ]
    }
  ]
